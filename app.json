{
  "expo": {
    "name": "ascenseur-counting-app",
    "slug": "ascenceur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060b14"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.ascenseurcountingapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c8c52824-e276-4848-aa7a-d9ca77b71bbf"
      }
    },
    "owner": "naklines-organization",
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#060b14"
        }
      ],
      "expo-status-bar",
      "expo-asset"
    ],
    "updates": {
      "url": "https://u.expo.dev/c8c52824-e276-4848-aa7a-d9ca77b71bbf",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
